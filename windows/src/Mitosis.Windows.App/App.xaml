<Application
    x:Class="Mitosis.Windows.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Mitosis.Windows.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Styles/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <!-- macOS rounds control corners to ~6 px; the WinUI default of 4
                         reads sharper than the reference app. -->
                    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <local:HexToBrushConverter x:Key="HexToBrush" />
            <local:NullToVisibilityConverter x:Key="NullToVisibility" />
            <local:StringToImageSourceConverter x:Key="PoseImage" />
            <local:HelpSymbolToGlyphConverter x:Key="TopicGlyph" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
