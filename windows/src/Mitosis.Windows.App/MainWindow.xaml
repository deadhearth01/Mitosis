<Window
    x:Class="Mitosis.Windows.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Mitosis.Windows.App"
    xmlns:views="using:Mitosis.Windows.App.Views"
    Title="Mitosis">

    <Grid RowDefinitions="Auto,*">
        <InfoBar
            Grid.Row="0"
            Title="{x:Bind BannerTitle, Mode=OneTime}"
            IsOpen="{x:Bind ViewModel.ShowUpdateBanner, Mode=OneWay}"
            Message="A new version of Mitosis is available."
            Severity="Informational">
            <InfoBar.ActionButton>
                <Button Command="{x:Bind ViewModel.InstallUpdateCommand, Mode=OneWay}" Content="Update Now" />
            </InfoBar.ActionButton>
        </InfoBar>

        <Grid Grid.Row="1" ColumnDefinitions="240,*">
            <Border
                Grid.Column="0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">
                <views:SidebarView x:Name="Sidebar" ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
            </Border>

            <views:CloneDetailView
                x:Name="DetailView"
                Grid.Column="1"
                ViewModel="{x:Bind ViewModel, Mode=OneWay}"
                Visibility="Collapsed" />

            <views:AppDetailView
                x:Name="AppView"
                Grid.Column="1"
                ViewModel="{x:Bind ViewModel, Mode=OneWay}"
                Visibility="Collapsed" />

            <views:OrphanProfileView
                x:Name="OrphanView"
                Grid.Column="1"
                ViewModel="{x:Bind ViewModel, Mode=OneWay}"
                Visibility="Collapsed" />

            <StackPanel
                x:Name="EmptyPanel"
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="420"
                Spacing="16">
                <Image
                    Width="168"
                    Height="168"
                    Source="ms-appx:///Assets/pose-empty.png">
                    <AutomationProperties.Name>Mito illustration</AutomationProperties.Name>
                </Image>
                <StackPanel Spacing="8">
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource MitosisTitle2Style}"
                        Text="No clones yet" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Choose an app to make your first one." />
                </StackPanel>
                <Button
                    HorizontalAlignment="Center"
                    Command="{x:Bind ViewModel.NewCloneCommand, Mode=OneWay}"
                    Content="Create Clone"
                    Style="{StaticResource AccentButtonStyle}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="or drag an app here" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
