        "args": [
          "--user-data-dir={dataPath}"
        ],
        "env": {}
      },
      "notes": "Electron app. Each clone has its own settings and login."
    },
    {
      "id": "vscode",
      "bundleIDs": [
        "com.microsoft.VSCode"
      ],
      "version": 1,
      "mode": "identity",
