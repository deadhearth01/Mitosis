<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Mitosis.Windows.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <UseWinUI>true</UseWinUI>
    <!-- Let Program.Main run first so the App SDK runtime is initialized before WinUI activates. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- Unpackaged (no MSIX): runs against the machine's Windows App SDK runtime. -->
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <ProjectReference Include="..\Mitosis.Windows.ViewModels\Mitosis.Windows.ViewModels.csproj" />
    <ProjectReference Include="..\Mitosis.Application\Mitosis.Application.csproj" />
    <ProjectReference Include="..\Mitosis.Compatibility\Mitosis.Compatibility.csproj" />
    <ProjectReference Include="..\Mitosis.Domain\Mitosis.Domain.csproj" />
    <ProjectReference Include="..\Mitosis.Infrastructure\Mitosis.Infrastructure.csproj" />
    <ProjectReference Include="..\Mitosis.Windows.Platform\Mitosis.Windows.Platform.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Original assets, referenced in place; the Assets tree is never modified. -->
    <Content Include="..\..\..\Assets\Brand\mascot-poses\pose-empty.png">
      <Link>Assets\pose-empty.png</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\..\Assets\Brand\mascot-poses\pose-success.png">
      <Link>Assets\pose-success.png</Link>
