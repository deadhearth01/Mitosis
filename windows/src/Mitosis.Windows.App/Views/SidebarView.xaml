<UserControl
    x:Class="Mitosis.Windows.App.Views.SidebarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Mitosis.Windows.App.Controls"
    xmlns:local="using:Mitosis.Windows.App"
    xmlns:viewmodels="using:Mitosis.Windows.ViewModels">

    <UserControl.Resources>
        <ResourceDictionary>
            <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <local:CloneToStatusTextConverter x:Key="StatusText" />
            <local:StatusToBrushConverter x:Key="StatusBrush" />
            <local:CompatibilityStatusToBrushConverter x:Key="AppStatusBrush" />
            <CollectionViewSource
                x:Name="GroupedClones"
                IsSourceGrouped="True"
                ItemsPath="Items"
                Source="{x:Bind ViewModel.VisibleGroups, Mode=OneWay}" />
            <CollectionViewSource
                x:Name="GroupedApps"
                IsSourceGrouped="True"
                ItemsPath="Items"
                Source="{x:Bind ViewModel.VisibleAppGroups, Mode=OneWay}" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <TextBlock
            Grid.Row="0"
            Margin="16,10,16,0"
            CharacterSpacing="20"
            FontSize="11"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
            Text="{x:Bind ViewModel.CloneCountSubtitle, Mode=OneWay}" />

        <AutoSuggestBox
            x:Name="SearchBox"
            Grid.Row="1"
            Margin="12,6,12,6"
            PlaceholderText="Search"
            PreviewKeyDown="OnSearchKeyDown"
            QueryIcon="Find"
            Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
            <AutomationProperties.Name>Search clones</AutomationProperties.Name>
        </AutoSuggestBox>

        <ListView
            Grid.Row="2"
            Margin="4,4,4,0"
            ItemsSource="{x:Bind GroupedClones.View, Mode=OneWay}"
            KeyDown="OnListKeyDown"
            RightTapped="OnListRightTapped"
            SelectedItem="{x:Bind ViewModel.SelectedClone, Mode=OneWay}"
            SelectionChanged="OnClonesSelectionChanged"
            SelectionMode="Single"
            Visibility="{x:Bind ViewModel.HasClones, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <AutomationProperties.Name>Clones grouped by app</AutomationProperties.Name>
            <ListView.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Command="{x:Bind ViewModel.OpenCloneCommand, Mode=OneWay}" Text="Open" />
                    <MenuFlyoutItem Command="{x:Bind ViewModel.RefreshCommand, Mode=OneWay}" Text="Refresh" />
                    <MenuFlyoutItem Command="{x:Bind ViewModel.EditBadgeCommand, Mode=OneWay}" Text="Edit Badge…" />
                    <MenuFlyoutItem Command="{x:Bind ViewModel.FindAppCommand, Mode=OneWay}" Text="Find App…" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Command="{x:Bind ViewModel.RevealCloneCommand, Mode=OneWay}" Text="Show in File Explorer" />
                    <MenuFlyoutItem Command="{x:Bind ViewModel.RevealOriginalCommand, Mode=OneWay}" Text="Show Original in File Explorer" />
                    <MenuFlyoutItem Command="{x:Bind ViewModel.RevealDataCommand, Mode=OneWay}" Text="Show Data Folder" />
                    <MenuFlyoutItem Command="{x:Bind ViewModel.CleanCachesCommand, Mode=OneWay}" Text="Clean Caches…" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Command="{x:Bind ViewModel.DeleteCommand, Mode=OneWay}" Text="Delete…" />
                </MenuFlyout>
            </ListView.ContextFlyout>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Margin" Value="4,0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Padding" Value="8,5" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate x:DataType="viewmodels:CloneGroupView">
                            <StackPanel
                                Margin="0,8,0,2"
                                Orientation="Horizontal"
                                Spacing="6">
                                <controls:CloneBadgeIcon
                                    IconSize="14"
                                    Initial="{x:Bind Group.Initial, Mode=OneTime}"
                                    InitialFontSize="9"
                                    TintHex="{x:Bind Group.TintHex, Mode=OneTime}" />
                                <TextBlock VerticalAlignment="Center" Text="{x:Bind Group.Name, Mode=OneTime}" />
                            </StackPanel>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:CloneItem">
                    <Grid
                        Padding="0,2"
                        ColumnDefinitions="Auto,*"
                        ColumnSpacing="10"
                        ToolTipService.ToolTip="{x:Bind Name, Mode=OneTime}">
                        <controls:CloneBadgeIcon
                            VerticalAlignment="Center"
                            IconSize="30"
                            Initial="{x:Bind BadgeText, Mode=OneTime}"
                            InitialFontSize="13"
                            TintHex="{x:Bind BadgeColorHex, Mode=OneTime}" />
                        <Grid
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            RowDefinitions="Auto,Auto"
                            RowSpacing="1">
                            <TextBlock
                                MaxLines="1"
                                Text="{x:Bind Label, Mode=OneTime}"
                                TextTrimming="CharacterEllipsis" />
                            <Grid
                                Grid.Row="1"
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="5">
                                <Ellipse
                                    Width="7"
                                    Height="7"
                                    Fill="{x:Bind Converter={StaticResource StatusBrush}, Mode=OneTime}" />
                                <TextBlock
                                    Grid.Column="1"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    MaxLines="1"
                                    Text="{x:Bind Converter={StaticResource StatusText}, Mode=OneTime}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel
            Grid.Row="2"
            Margin="4,4,4,0"
            Spacing="2"
            Visibility="{x:Bind ViewModel.HasOrphans, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <TextBlock
                Margin="12,10,0,4"
                CharacterSpacing="60"
                FontSize="11"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="Unavailable" />
            <ListView
                ItemsSource="{x:Bind ViewModel.OrphanProfiles, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedOrphan, Mode=OneWay}"
                SelectionChanged="OnOrphansSelectionChanged"
                SelectionMode="Single">
                <AutomationProperties.Name>Profiles whose app was not found</AutomationProperties.Name>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Margin" Value="4,0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Padding" Value="8,5" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:OrphanProfileItem">
                        <Grid
                            Padding="0,2"
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="10"
                            ToolTipService.ToolTip="{x:Bind Profile.Name, Mode=OneTime}">
                            <controls:CloneBadgeIcon
                                VerticalAlignment="Center"
                                IconSize="30"
                                Initial="?"
                                InitialFontSize="13"
                                TintHex="#8E8E93" />
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="1">
                                <TextBlock
                                    MaxLines="1"
                                    Text="{x:Bind Profile.Name, Mode=OneTime}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    MaxLines="1"
                                    Text="{x:Bind StateText, Mode=OneTime}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <ListView
            Grid.Row="2"
            Margin="4,4,4,0"
            ContainerContentChanging="OnAppsContainerContentChanging"
            ItemsSource="{x:Bind GroupedApps.View, Mode=OneWay}"
            KeyDown="OnAppsKeyDown"
            SelectedItem="{x:Bind ViewModel.SelectedApp, Mode=OneWay}"
            SelectionChanged="OnAppsSelectionChanged"
            SelectionMode="Single"
            Visibility="{x:Bind ViewModel.HasApps, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <AutomationProperties.Name>Installed applications</AutomationProperties.Name>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Margin" Value="4,0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Padding" Value="8,5" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate x:DataType="viewmodels:AppGroupView">
                            <TextBlock
                                Margin="0,10,0,4"
                                CharacterSpacing="60"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="{x:Bind Group.Name, Mode=OneTime}" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:DiscoveredAppItem">
                    <Grid
                        Padding="0,2"
                        ColumnDefinitions="Auto,*"
                        ColumnSpacing="10"
                        ToolTipService.ToolTip="{x:Bind App.DisplayName, Mode=OneTime}">
                        <Grid
                            Width="30"
                            Height="30"
                            VerticalAlignment="Center">
                            <controls:CloneBadgeIcon
                                x:Name="AppBadge"
                                IconSize="30"
                                Initial="{x:Bind Initial, Mode=OneTime}"
                                InitialFontSize="13"
                                TintHex="#8E8E93" />
                            <Image
                                x:Name="AppIcon"
                                Width="30"
                                Height="30"
                                Stretch="Uniform"
                                Visibility="Collapsed" />
                        </Grid>
                        <Grid
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            RowDefinitions="Auto,Auto"
                            RowSpacing="1">
                            <TextBlock
                                MaxLines="1"
                                Text="{x:Bind App.DisplayName, Mode=OneTime}"
                                TextTrimming="CharacterEllipsis" />
                            <Grid
                                Grid.Row="1"
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="5">
                                <Ellipse
                                    Width="7"
                                    Height="7"
                                    VerticalAlignment="Center"
                                    Fill="{x:Bind Assessment.Status, Mode=OneTime, Converter={StaticResource AppStatusBrush}}" />
                                <TextBlock
                                    Grid.Column="1"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    MaxLines="1"
                                    Text="{x:Bind StatusText, Mode=OneTime}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel
            Grid.Row="2"
            Margin="16"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind ViewModel.ShowAppsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <ProgressRing Width="24" Height="24" IsActive="True" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Finding your apps…" />
        </StackPanel>

        <StackPanel
            Grid.Row="2"
            Margin="16"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind ViewModel.ShowAppsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <TextBlock
                HorizontalAlignment="Center"
                FontWeight="SemiBold"
                Text="No applications found." />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Mitosis lists apps from Windows registrations."
                TextWrapping="Wrap" />
            <Button
                HorizontalAlignment="Center"
                Command="{x:Bind ViewModel.RefreshAppsCommand, Mode=OneWay}"
                Content="Retry" />
        </StackPanel>

        <StackPanel
            Grid.Row="2"
            Margin="16"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind ViewModel.ShowAppsError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <SymbolIcon
                HorizontalAlignment="Center"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Symbol="Important" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.DiscoveryError, Mode=OneWay}"
                TextWrapping="Wrap" />
            <Button
                HorizontalAlignment="Center"
                Command="{x:Bind ViewModel.RefreshAppsCommand, Mode=OneWay}"
                Content="Retry" />
            <Button
                HorizontalAlignment="Center"
                Command="{x:Bind ViewModel.ShowPreviewCommand, Mode=OneWay}"
                Content="Show preview instead" />
        </StackPanel>

        <StackPanel
            Grid.Row="2"
            Margin="16"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="4"
            Visibility="{x:Bind ViewModel.HasNoResults, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <TextBlock
                HorizontalAlignment="Center"
                Text="{x:Bind ViewModel.NoResultsText, Mode=OneWay}"
                TextWrapping="Wrap" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Check the spelling or try looking for something else."
                TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="16,12">
            <Button
                Margin="0,4"
                Padding="0,4"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Background="Transparent"
                BorderThickness="0"
                Command="{x:Bind ViewModel.NewCloneCommand, Mode=OneWay}"
                ToolTipService.ToolTip="Create a clone (Ctrl+N)">
                <AutomationProperties.Name>New Clone</AutomationProperties.Name>
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="N" Modifiers="Control" />
                </Button.KeyboardAccelerators>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <SymbolIcon Foreground="{ThemeResource MitosisAccentBrush}" Symbol="Add" />
                    <TextBlock
                        FontWeight="Medium"
                        Foreground="{ThemeResource MitosisAccentBrush}"
                        Text="New Clone" />
                </StackPanel>
            </Button>
            <!-- Windows adaptation for the missing menu bar (matrix W05): Help and
                 Settings surface here; F1 opens Help, Ctrl+, opens Settings. -->
            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" Spacing="12">
                <Button
                    Margin="-4,0,0,0"
                    Padding="0,4"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.ShowHelpCommand, Mode=OneWay}"
                    ToolTipService.ToolTip="Mitosis Help (F1)">
                    <AutomationProperties.Name>Help</AutomationProperties.Name>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Symbol="Help" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Help" />
                    </StackPanel>
                </Button>
                <Button
                    Padding="0,4"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.ShowSettingsCommand, Mode=OneWay}"
                    ToolTipService.ToolTip="Settings (Ctrl+,)">
                    <AutomationProperties.Name>Settings</AutomationProperties.Name>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Symbol="Setting" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Settings" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
