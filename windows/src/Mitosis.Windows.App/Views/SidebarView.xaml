<UserControl
    x:Class="Mitosis.Windows.App.Views.SidebarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Mitosis.Windows.App.Controls"
    xmlns:local="using:Mitosis.Windows.App"
    xmlns:viewmodels="using:Mitosis.Windows.ViewModels">

    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <local:CloneToStatusTextConverter x:Key="StatusText" />
        <local:StatusToBrushConverter x:Key="StatusBrush" />
        <CollectionViewSource
            x:Name="GroupedClones"
            IsSourceGrouped="True"
            ItemsPath="Items"
            Source="{x:Bind ViewModel.VisibleGroups, Mode=OneWay}" />
        <CollectionViewSource
            x:Name="GroupedApps"
            IsSourceGrouped="True"
            ItemsPath="Items"
            Source="{x:Bind ViewModel.VisibleAppGroups, Mode=OneWay}" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <TextBlock
            Grid.Row="0"
            Margin="16,12,16,0"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind ViewModel.CloneCountSubtitle, Mode=OneWay}" />

        <AutoSuggestBox
            x:Name="SearchBox"
            Grid.Row="1"
            Margin="12,4,12,4"
            PlaceholderText="Search"
            QueryIcon="Find"
            Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
            <AutomationProperties.Name>Search clones</AutomationProperties.Name>
        </AutoSuggestBox>

        <ListView
            Grid.Row="2"
            Margin="4,4,4,0"
            ItemsSource="{x:Bind GroupedClones.View, Mode=OneWay}"
            KeyDown="OnListKeyDown"
            RightTapped="OnListRightTapped"
            SelectedItem="{x:Bind ViewModel.SelectedClone, Mode=TwoWay}"
            SelectionMode="Single"
            Visibility="{x:Bind ViewModel.HasClones, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <AutomationProperties.Name>Clones grouped by app</AutomationProperties.Name>
            <ListView.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Command="{x:Bind ViewModel.OpenCloneCommand, Mode=OneWay}" Text="Open" />
                    <MenuFlyoutItem Command="{x:Bind ViewModel.RefreshCommand, Mode=OneWay}" Text="Refresh" />
                    <MenuFlyoutItem Command="{x:Bind ViewModel.EditBadgeCommand, Mode=OneWay}" Text="Edit Badge…" />
                    <MenuFlyoutItem Command="{x:Bind ViewModel.FindAppCommand, Mode=OneWay}" Text="Find App…" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Command="{x:Bind ViewModel.RevealCloneCommand, Mode=OneWay}" Text="Show in File Explorer" />
                    <MenuFlyoutItem Command="{x:Bind ViewModel.RevealOriginalCommand, Mode=OneWay}" Text="Show Original in File Explorer" />
                    <MenuFlyoutItem Command="{x:Bind ViewModel.RevealDataCommand, Mode=OneWay}" Text="Show Data Folder" />
                    <MenuFlyoutItem Command="{x:Bind ViewModel.CleanCachesCommand, Mode=OneWay}" Text="Clean Caches…" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Command="{x:Bind ViewModel.DeleteCommand, Mode=OneWay}" Text="Delete…" />
                </MenuFlyout>
            </ListView.ContextFlyout>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate x:DataType="viewmodels:CloneGroupView">
                            <StackPanel
                                Margin="0,8,0,2"
                                Orientation="Horizontal"
                                Spacing="6">
                                <controls:CloneBadgeIcon
                                    IconSize="14"
                                    Initial="{x:Bind Group.Initial, Mode=OneTime}"
                                    InitialFontSize="9"
                                    TintHex="{x:Bind Group.TintHex, Mode=OneTime}" />
                                <TextBlock VerticalAlignment="Center" Text="{x:Bind Group.Name, Mode=OneTime}" />
                            </StackPanel>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:CloneItem">
                    <StackPanel
                        Padding="0,2"
                        Orientation="Horizontal"
                        Spacing="10"
                        ToolTipService.ToolTip="{x:Bind Name, Mode=OneTime}">
                        <controls:CloneBadgeIcon
                            IconSize="30"
                            Initial="{x:Bind BadgeText, Mode=OneTime}"
                            InitialFontSize="13"
                            TintHex="{x:Bind BadgeColorHex, Mode=OneTime}" />
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock MaxLines="1" Text="{x:Bind Label, Mode=OneTime}" />
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Ellipse
                                    Width="7"
                                    Height="7"
                                    Fill="{x:Bind Converter={StaticResource StatusBrush}, Mode=OneTime}" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    MaxLines="1"
                                    Text="{x:Bind Converter={StaticResource StatusText}, Mode=OneTime}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel
            Grid.Row="2"
            Margin="4,4,4,0"
            Spacing="2"
            Visibility="{x:Bind ViewModel.HasOrphans, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <TextBlock
                Margin="12,8,0,2"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Unavailable" />
            <ListView
                ItemsSource="{x:Bind ViewModel.OrphanProfiles, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedOrphan, Mode=TwoWay}"
                SelectionMode="Single">
                <AutomationProperties.Name>Profiles whose app was not found</AutomationProperties.Name>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:OrphanProfileItem">
                        <StackPanel
                            Padding="0,2"
                            Orientation="Horizontal"
                            Spacing="10"
                            ToolTipService.ToolTip="{x:Bind Profile.Name, Mode=OneTime}">
                            <controls:CloneBadgeIcon
                                IconSize="30"
                                Initial="?"
                                InitialFontSize="13"
                                TintHex="#8E8E93" />
                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                <TextBlock MaxLines="1" Text="{x:Bind Profile.Name, Mode=OneTime}" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    MaxLines="1"
                                    Text="{x:Bind StateText, Mode=OneTime}" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <ListView
            Grid.Row="2"
            Margin="4,4,4,0"
            ItemsSource="{x:Bind GroupedApps.View, Mode=OneWay}"
            KeyDown="OnAppsKeyDown"
            SelectedItem="{x:Bind ViewModel.SelectedApp, Mode=TwoWay}"
            SelectionMode="Single"
            Visibility="{x:Bind ViewModel.HasApps, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <AutomationProperties.Name>Installed applications</AutomationProperties.Name>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate x:DataType="viewmodels:AppGroupView">
                            <TextBlock
                                Margin="0,8,0,2"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Group.Name, Mode=OneTime}" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:DiscoveredAppItem">
                    <StackPanel
                        Padding="0,2"
                        Orientation="Horizontal"
                        Spacing="10"
                        ToolTipService.ToolTip="{x:Bind App.DisplayName, Mode=OneTime}">
                        <controls:CloneBadgeIcon
                            IconSize="30"
                            Initial="{x:Bind Initial, Mode=OneTime}"
                            InitialFontSize="13"
                            TintHex="#8E8E93" />
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock MaxLines="1" Text="{x:Bind App.DisplayName, Mode=OneTime}" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                MaxLines="1"
                                Text="{x:Bind StatusText, Mode=OneTime}" />
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel
            Grid.Row="2"
            Margin="16"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind ViewModel.ShowAppsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <ProgressRing Width="24" Height="24" IsActive="True" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Finding your apps…" />
        </StackPanel>

        <StackPanel
            Grid.Row="2"
            Margin="16"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind ViewModel.ShowAppsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <TextBlock
                HorizontalAlignment="Center"
                FontWeight="SemiBold"
                Text="No applications found." />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Mitosis lists apps from Windows registrations."
                TextWrapping="Wrap" />
            <Button
                HorizontalAlignment="Center"
                Command="{x:Bind ViewModel.RefreshAppsCommand, Mode=OneWay}"
                Content="Retry" />
        </StackPanel>

        <StackPanel
            Grid.Row="2"
            Margin="16"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind ViewModel.ShowAppsError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <SymbolIcon
                HorizontalAlignment="Center"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Symbol="Important" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.DiscoveryError, Mode=OneWay}"
                TextWrapping="Wrap" />
            <Button
                HorizontalAlignment="Center"
                Command="{x:Bind ViewModel.RefreshAppsCommand, Mode=OneWay}"
                Content="Retry" />
            <Button
                HorizontalAlignment="Center"
                Command="{x:Bind ViewModel.ShowPreviewCommand, Mode=OneWay}"
                Content="Show preview instead" />
        </StackPanel>

        <TextBlock
            Grid.Row="2"
            Margin="16"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="No clones match your search."
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.HasNoResults, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

        <Button
            Grid.Row="3"
            Margin="16,12"
            Padding="0,4"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Left"
            Background="Transparent"
            BorderThickness="0"
            Command="{x:Bind ViewModel.NewCloneCommand, Mode=OneWay}"
            ToolTipService.ToolTip="Create a clone (Ctrl+N)">
            <AutomationProperties.Name>New Clone</AutomationProperties.Name>
            <Button.KeyboardAccelerators>
                <KeyboardAccelerator Key="N" Modifiers="Control" />
            </Button.KeyboardAccelerators>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <SymbolIcon Foreground="{ThemeResource MitosisAccentBrush}" Symbol="Add" />
                <TextBlock
                    FontWeight="Medium"
                    Foreground="{ThemeResource MitosisAccentBrush}"
                    Text="New Clone" />
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
