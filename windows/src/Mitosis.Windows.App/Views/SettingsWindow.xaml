<Window
    x:Class="Mitosis.Windows.App.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Mitosis Settings">

    <!-- macOS: width 540, two tabs General/Advanced (SettingsView.swift:9-19).
         Only settings with real, testable effects are shown; captions name the
         macOS settings that are not implemented on Windows. -->
    <Grid>
        <NavigationView
            PaneDisplayMode="Top"
            SelectionChanged="OnTabSelected"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="GeneralTab" Content="General" IsSelected="True" Tag="General">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Advanced" Tag="Advanced">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE700;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <ScrollViewer>
                <StackPanel
                    Margin="24,8,24,24"
                    MaxWidth="480"
                    HorizontalAlignment="Left"
                    Spacing="8">

                    <StackPanel x:Name="GeneralPanel" Spacing="8">
                        <TextBlock Style="{StaticResource MitosisSectionTitleStyle}" Text="Storage" />
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8">
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Text="Data folder" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ViewModel.DataFolderPath, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <Button
                                Grid.Row="0"
                                Grid.Column="1"
                                Grid.RowSpan="2"
                                VerticalAlignment="Center"
                                Command="{x:Bind ViewModel.RevealDataFolderCommand, Mode=OneWay}"
                                Content="Show in File Explorer" />
                        </Grid>
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Mitosis keeps clone profiles and compatibility evidence here. Clone folders arrive with the cloning engine."
                            TextWrapping="Wrap" />
                        <TextBlock
                            Style="{StaticResource MitosisSectionTitleStyle}"
                            Margin="0,8,0,0"
                            Text="Diagnostics" />
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8">
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Text="Log folder" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ViewModel.LogFolderPath, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <Button
                                Grid.Row="0"
                                Grid.Column="1"
                                Grid.RowSpan="2"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Show log folder in File Explorer"
                                Command="{x:Bind ViewModel.RevealLogFolderCommand, Mode=OneWay}"
                                Content="Show in File Explorer" />
                        </Grid>
                        <Button
                            x:Name="CopyDiagnosticsButton"
                            Command="{x:Bind ViewModel.CopyDiagnosticsCommand, Mode=OneWay}"
                            Content="Copy diagnostics" />
                        <TextBlock
                            x:Name="CopyConfirmation"
                            AutomationProperties.LiveSetting="Polite"
                            FontSize="12"
                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                            Text="Diagnostics copied to the clipboard."
                            Visibility="Collapsed" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Logs record app start/stop and unexpected errors only. They stay on this PC and never include application data, credentials, or file contents."
                            TextWrapping="Wrap" />
                        <TextBlock
                            Style="{StaticResource MitosisSectionTitleStyle}"
                            Margin="0,8,0,0"
                            Text="Updates" />
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8">
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Text="Version" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ViewModel.CurrentVersionText, Mode=OneWay}" />
                            <Button
                                x:Name="CheckForUpdatesButton"
                                Grid.Row="0"
                                Grid.Column="1"
                                Grid.RowSpan="2"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Check GitHub for a newer Mitosis release"
                                Command="{x:Bind ViewModel.CheckForUpdatesCommand, Mode=OneWay}"
                                Content="{x:Bind ViewModel.CheckForUpdatesLabel, Mode=OneWay}" />
                        </Grid>
                        <TextBlock
                            x:Name="UpdateStatus"
                            AutomationProperties.LiveSetting="Polite"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.UpdateStatusText, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <HyperlinkButton
                            x:Name="ViewReleaseLink"
                            Margin="0,-4,0,0"
                            Content="View Release"
                            NavigateUri="{x:Bind ViewModel.UpdateReleaseUrl, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HasUpdateLink, Mode=OneWay}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="The check reads GitHub's public release list only when you press the button. It sends no account or usage data, downloads nothing, and installs nothing."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel x:Name="AdvancedPanel" Spacing="8" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource MitosisSectionTitleStyle}" Text="Tips and the welcome screen" />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock
                                Grid.Column="0"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Restores the tips shown in the app picker and the welcome screen."
                                TextWrapping="Wrap" />
                            <Button
                                x:Name="TipsButton"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Command="{x:Bind ViewModel.ShowTipsAgainCommand, Mode=OneWay}"
                                Content="Show Tips Again" />
                        </Grid>
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Turns the welcome screen and tips back on for the next launch of Mitosis."
                            TextWrapping="Wrap" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="The default-clone-mode picker arrives with the cloning engine."
                            TextWrapping="Wrap" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="The tray icon and the command-line installer are not implemented on Windows yet, so they are not listed here."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <InfoBar
                        x:Name="SaveErrorBar"
                        AutomationProperties.LiveSetting="Polite"
                        IsOpen="False"
                        Severity="Error"
                        Title="Couldn't save settings" />
                </StackPanel>
            </ScrollViewer>
        </NavigationView>
    </Grid>
</Window>
