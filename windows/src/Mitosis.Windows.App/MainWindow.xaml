<Window
    x:Class="Mitosis.Windows.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Mitosis.Windows.App"
    xmlns:views="using:Mitosis.Windows.App.Views"
    Title="Mitosis">

    <!-- Row 0 is the custom title bar (macOS-style unified toolbar): the sidebar tint
         runs up behind the caption area on the left, the content surface on the right.
         It is set as the window's drag region in code, not a caption-control duplicate. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleBarRow" Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            ColumnDefinitions="240,*">
            <Border Grid.Column="0" Background="{ThemeResource MitosisSidebarBrush}" />
            <Border Grid.Column="1" Background="{ThemeResource MitosisContentBackgroundBrush}" />
            <StackPanel
                Grid.Column="1"
                Padding="20,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <TextBlock
                    AutomationProperties.AccessibilityView="Raw"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Text="Mitosis" />
                <TextBlock
                    AutomationProperties.AccessibilityView="Raw"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind ViewModel.CloneCountSubtitle, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <InfoBar
            Grid.Row="1"
            Title="{x:Bind ViewModel.BannerTitle, Mode=OneWay}"
            CloseButtonClick="OnUpdateBannerClosed"
            IsOpen="{x:Bind ViewModel.ShowUpdateBanner, Mode=OneWay}"
            Message="A new version of Mitosis is available."
            Severity="Informational">
            <InfoBar.ActionButton>
                <Button Command="{x:Bind ViewModel.UpdateBannerCommand, Mode=OneWay}" Content="{x:Bind ViewModel.UpdateBannerActionText, Mode=OneWay}" />
            </InfoBar.ActionButton>
        </InfoBar>

        <Grid Grid.Row="2" ColumnDefinitions="240,*">
            <Border Grid.Column="0" Background="{ThemeResource MitosisSidebarBrush}">
                <views:SidebarView x:Name="Sidebar" ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
            </Border>

            <Border Grid.Column="1" Background="{ThemeResource MitosisContentBackgroundBrush}" />

            <views:CloneDetailView
                x:Name="DetailView"
                Grid.Column="1"
                ViewModel="{x:Bind ViewModel, Mode=OneWay}"
                Visibility="Collapsed" />

            <views:AppDetailView
                x:Name="AppView"
                Grid.Column="1"
                ViewModel="{x:Bind ViewModel, Mode=OneWay}"
                Visibility="Collapsed" />

            <views:OrphanProfileView
                x:Name="OrphanView"
                Grid.Column="1"
                ViewModel="{x:Bind ViewModel, Mode=OneWay}"
                Visibility="Collapsed" />

            <StackPanel
                x:Name="EmptyPanel"
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="420"
                Spacing="12">
                <Image
                    Width="160"
                    Height="160"
                    Source="ms-appx:///Assets/pose-empty.png">
                    <AutomationProperties.AccessibilityView>Raw</AutomationProperties.AccessibilityView>
                </Image>
                <StackPanel Spacing="6">
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource MitosisTitle2Style}"
                        Text="No clones yet" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Choose an app to make your first one." />
                </StackPanel>
                <Button
                    HorizontalAlignment="Center"
                    Command="{x:Bind ViewModel.NewCloneCommand, Mode=OneWay}"
                    Content="Create Clone"
                    Style="{StaticResource AccentButtonStyle}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="or pick one from the sidebar" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
