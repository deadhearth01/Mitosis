<UserControl
    x:Class="Mitosis.Windows.App.Views.AppDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Mitosis.Windows.App.Controls">

    <ScrollViewer>
        <StackPanel
            MaxWidth="780"
            Padding="32,28"
            Spacing="28">
            <!-- Header -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="24">
                <controls:CloneBadgeIcon
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    IconSize="104"
                    Initial="{x:Bind ViewModel.SelectedApp.Initial, Mode=OneWay}"
                    InitialFontSize="40"
                    TileCornerRadius="22"
                    TintHex="#8E8E93" />
                <StackPanel Grid.Column="1" Spacing="8">
                    <TextBlock Style="{StaticResource MitosisDetailNameStyle}" Text="{x:Bind ViewModel.SelectedApp.App.DisplayName, Mode=OneWay}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.SelectedAppPublisherLine, Mode=OneWay}" />
                    <TextBlock
                        FontSize="13"
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.SelectedApp.StatusText, Mode=OneWay}" />
                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal" Spacing="8">
                        <Button
                            Command="{x:Bind ViewModel.CreateCloneFromAppCommand, Mode=OneWay}"
                            Content="New Clone…"
                            Style="{StaticResource AccentButtonStyle}">
                            <AutomationProperties.Name>New clone from this app</AutomationProperties.Name>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Details -->
            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource MitosisSectionTitleStyle}" Text="Details" />
                <Border Style="{StaticResource MitosisCardStyle}">
                    <StackPanel>
                        <Grid Padding="16,11" ColumnDefinitions="*,Auto">
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Publisher" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedAppPublisherOrUnknown, Mode=OneWay}" />
                        </Grid>
                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Margin="16,0" />
                        <Grid Padding="16,11" ColumnDefinitions="*,Auto">
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Version" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedAppVersionOrUnknown, Mode=OneWay}" />
                        </Grid>
                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Margin="16,0" />
                        <Grid Padding="16,11" ColumnDefinitions="*,Auto">
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Installed for" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedAppScopeText, Mode=OneWay}" />
                        </Grid>
                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Margin="16,0" />
                        <Grid Padding="16,11" ColumnDefinitions="*,Auto">
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Found via" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedAppSourcesText, Mode=OneWay}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Compatibility -->
            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource MitosisSectionTitleStyle}" Text="Compatibility" />
                <Border Style="{StaticResource MitosisCardStyle}" Padding="16,12">
                    <StackPanel Spacing="8">
                        <TextBlock FontSize="14" FontWeight="Medium" Text="{x:Bind ViewModel.SelectedApp.StatusText, Mode=OneWay}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedAppReasons, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        FontSize="13"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Mode=OneTime}"
                                        TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Independent copies arrive in a later stage."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
