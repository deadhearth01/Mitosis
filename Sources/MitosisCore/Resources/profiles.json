{
  "schema": 1,
  "profiles": [
    {
      "id": "slack",
      "bundleIDs": [
        "com.tinyspeck.slackmacgap"
      ],
      "version": 1,
      "mode": "identity",
      "support": "full",
      "launch": {
        "args": [
          "--user-data-dir={dataPath}"
        ],
        "env": {}
      },
      "notes": "Electron app. Each clone keeps its own workspaces and login."
    },
    {
      "id": "discord",
      "bundleIDs": [
        "com.hnc.Discord"
      ],
      "version": 1,
      "mode": "identity",
      "support": "full",
      "launch": {
        "args": [
          "--user-data-dir={dataPath}"
        ],
        "env": {}
      },
      "notes": "Electron app. Each clone keeps its own account."
    },
    {
      "id": "claude",
      "bundleIDs": [
        "com.anthropic.claudefordesktop"
      ],
      "version": 1,
      "mode": "identity",
      "support": "full",
      "launch": {
        "args": [
          "--user-data-dir={dataPath}"
        ],
        "env": {}
      },
      "notes": "Electron app. Each clone signs in separately."
    },
    {
      "id": "codex",
      "bundleIDs": [
        "com.openai.codex"
      ],
      "version": 2,
      "mode": "identity",
      "support": "full",
      "launch": {
        "args": [
          "--user-data-dir={dataPath}"
        ],
        "env": {
          "CODEX_HOME": "{dataPath}/codex-home"
        }
